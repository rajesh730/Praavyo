# Root-level maintenance scripts (npm run db:inspect, seed:curriculum,
# migrate:cas-global-exams, ...). Copy to `.env.local` at the repo root.
#
# This is NOT the app's configuration. The deployed app (Pravyo + CAS, one
# Next.js app at apps/pravyo, live at https://praavyo.com) reads
# apps/pravyo/.env.example locally and the Vercel dashboard in production.

# Same MongoDB database as the app. Point at production only on purpose —
# these scripts write to whatever database this names.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/pravyo

# Only for scripts/sync-pravyo.mjs and scripts/install-dashboard-integration.mjs.
PRAVYO_SOURCE=../schoolproject
